# PostgreSQL connection string; URL-encode special characters in the password.
DATABASE_URL=

# Generate a unique signing key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# Use unique branch-admin credentials. Configure before running the seed script.
BRANCH1_ADMIN_EMAIL=
BRANCH1_ADMIN_PASSWORD=
BRANCH2_ADMIN_EMAIL=
BRANCH2_ADMIN_PASSWORD=
